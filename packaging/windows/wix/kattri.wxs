<?xml version="1.0" encoding="UTF-8"?>
<!--
  Dual-purpose MSI for Jellyfin Kattri (WiX v4 schema).

  Install scope (owner decision 2026-10-27, replacing D11 per-user only): Scope
  perUserOrMachine sets ALLUSERS=2 and MSIINSTALLPERUSER=1, so a plain install is per
  user, under %LOCALAPPDATA%\Programs\Jellyfin Kattri, with no UAC prompt. Windows
  Installer redirects ProgramFiles6432Folder to that per-user location in this mode.
  A per-machine install under Program Files for all users is chosen at install time
  on the command line, and elevates:
    msiexec /i JellyfinKattri-<version>-<platform>.msi ALLUSERS=1
  Registry values use HKMU, which resolves to HKCU per user and HKLM per machine.
  The portable zip is built separately by build-zip.ps1.

  Upgrade code: 35630542-A9E3-4ADD-AA5E-51534AC570F5
    This GUID identifies the product family for major upgrades. It must never
    change once a release has shipped, because changing it makes Windows Installer
    treat new builds as an unrelated product and leaves old installs behind.
    The product code is generated per build. MajorUpgrade requires a new product
    code for each version, so the product code is not pinned here.

  Defines supplied on the command line by build-msi.ps1:
    Version      four-part or three-part numeric version, for example 1.2.3
    ExePath      full path to the release executable for the target platform
    ExeName      file name of that executable, for example jellyfin-kattri.exe
    LicensePath  full path to the license file to install alongside the executable
    LibmpvPath   full path to the verified libmpv-2.dll, installed next to the executable
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
    Name="Jellyfin Kattri"
    Manufacturer="Kattri"
    Version="$(var.Version)"
    UpgradeCode="35630542-A9E3-4ADD-AA5E-51534AC570F5"
    Language="1033"
    Scope="perUserOrMachine">

    <MajorUpgrade DowngradeErrorMessage="A newer version of Jellyfin Kattri is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <!-- Application icon. One File entry in the package carries it, and both the Add/Remove
         Programs entry and the Start menu shortcut point at it. -->
    <Icon Id="KattriIcon" SourceFile="$(var.IconPath)" />
    <Property Id="ARPPRODUCTICON" Value="KattriIcon" />

    <Feature Id="MainFeature" Title="Jellyfin Kattri" Level="1">
      <ComponentRef Id="ExecutableComponent" />
      <ComponentRef Id="LicenseComponent" />
      <ComponentRef Id="LibmpvComponent" />
      <ComponentRef Id="StartMenuShortcutComponent" />
    </Feature>

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="Jellyfin Kattri">

        <Component Id="ExecutableComponent" Guid="*">
          <File Id="MainExecutable" Source="$(var.ExePath)" Name="$(var.ExeName)" KeyPath="yes" />
          <RemoveFolder Id="RemoveInstallFolder" Directory="INSTALLFOLDER" On="uninstall" />
        </Component>

        <Component Id="LibmpvComponent" Guid="*">
          <File Id="LibmpvDll" Source="$(var.LibmpvPath)" Name="libmpv-2.dll" KeyPath="yes" />
        </Component>

        <Component Id="LicenseComponent" Guid="*">
          <File Id="LicenseFile" Source="$(var.LicensePath)" Name="LICENSE.txt" KeyPath="yes" />
        </Component>

      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramMenuFolder" Name="Jellyfin Kattri">
        <!--
          The start menu shortcut needs a key path: a registry value that records the
          shortcut was installed. HKMU writes it to HKCU for a per-user install and to
          HKLM for a per-machine one, matching where the shortcut goes.
        -->
        <Component Id="StartMenuShortcutComponent" Guid="*">
          <Shortcut
            Id="StartMenuShortcut"
            Name="Jellyfin Kattri"
            Description="Jellyfin Kattri"
            Target="[INSTALLFOLDER]$(var.ExeName)"
            WorkingDirectory="INSTALLFOLDER"
            Icon="KattriIcon" />
          <RegistryValue
            Root="HKMU"
            Key="Software\Jellyfin Kattri"
            Name="StartMenuShortcutInstalled"
            Type="integer"
            Value="1"
            KeyPath="yes" />
          <RemoveFolder Id="RemoveApplicationProgramMenuFolder" Directory="ApplicationProgramMenuFolder" On="uninstall" />
        </Component>
      </Directory>
    </StandardDirectory>

  </Package>
</Wix>
